<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /gamartisan/

    # If the request is for an existing file or directory in public/, serve it directly
    RewriteCond %{REQUEST_URI} !^/gamartisan/public/
    RewriteRule ^$ public/ [L]

    RewriteCond %{REQUEST_URI} !^/gamartisan/public/
    RewriteRule (.*) public/$1 [L]

    # Once in public/, if not a real file/directory, send to index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^public/(.*)$ public/index.php [L]
</IfModule>
